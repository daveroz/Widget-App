<?xml version="1.0" encoding="utf-8"?>
<!-- Generated: the Currency widget with 2 currency row(s). Its clocks card (each clock on its city's sky right now,
     CurrencyView / Sky) and one card holding the rows, thin lines between them; fixed-size content (dp) in flexible
     rows, so any widget size keeps the same proportions. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <!-- the clocks card -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/clk_glass"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="94dp"
                android:background="@drawable/cur_clocks"
                android:clipToOutline="true"
                android:orientation="horizontal"
                android:padding="1dp">
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/clk_bg_0"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp">
                    <ImageView
                        android:id="@+id/clk_day_0"
                        android:layout_width="match_parent"
                        android:layout_height="16dp"
                        android:scaleType="fitCenter" />
                    <ImageView
                        android:id="@+id/clk_time_0"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:scaleType="fitCenter" />
                    <ImageView
                        android:id="@+id/clk_city_0"
                        android:layout_width="match_parent"
                        android:layout_height="16dp"
                        android:layout_marginTop="-3dp"
                        android:scaleType="fitCenter" />
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/clk_bg_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp">
                    <ImageView
                        android:id="@+id/clk_day_1"
                        android:layout_width="match_parent"
                        android:layout_height="16dp"
                        android:scaleType="fitCenter" />
                    <ImageView
                        android:id="@+id/clk_time_1"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:scaleType="fitCenter" />
                    <ImageView
                        android:id="@+id/clk_city_1"
                        android:layout_width="match_parent"
                        android:layout_height="16dp"
                        android:layout_marginTop="-3dp"
                        android:scaleType="fitCenter" />
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/clk_bg_2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp">
                    <ImageView
                        android:id="@+id/clk_day_2"
                        android:layout_width="match_parent"
                        android:layout_height="16dp"
                        android:scaleType="fitCenter" />
                    <ImageView
                        android:id="@+id/clk_time_2"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:scaleType="fitCenter" />
                    <ImageView
                        android:id="@+id/clk_city_2"
                        android:layout_width="match_parent"
                        android:layout_height="16dp"
                        android:layout_marginTop="-3dp"
                        android:scaleType="fitCenter" />
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/clk_bg_3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp">
                    <ImageView
                        android:id="@+id/clk_day_3"
                        android:layout_width="match_parent"
                        android:layout_height="16dp"
                        android:scaleType="fitCenter" />
                    <ImageView
                        android:id="@+id/clk_time_3"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:scaleType="fitCenter" />
                    <ImageView
                        android:id="@+id/clk_city_3"
                        android:layout_width="match_parent"
                        android:layout_height="16dp"
                        android:layout_marginTop="-3dp"
                        android:scaleType="fitCenter" />
                </LinearLayout>
            </FrameLayout>
            </LinearLayout>
            <ImageView
                android:id="@+id/clk_rim"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY" />
        </FrameLayout>
        <!-- the currency rows, on one card -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <ImageView
                android:id="@+id/rates_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/cur_clocks"
                android:clipToOutline="true"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">
            <FrameLayout
                android:id="@+id/row_0"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:foreground="?android:attr/selectableItemBackground">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="24dp">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:id="@+id/fl_a_0"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:scaleType="fitCenter" />
                        <!-- a fixed width, so every row's arrow and second flag line up -->
                        <ImageView
                            android:id="@+id/code_a_0"
                            android:layout_width="40dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="6dp"
                            android:scaleType="fitStart" />
                        <ImageView
                            android:id="@+id/arrow_0"
                            android:layout_width="12dp"
                            android:layout_height="16dp"
                            android:src="@drawable/cur_arrow"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="10dp"
                            android:scaleType="fitCenter" />
                        <ImageView
                            android:id="@+id/fl_b_0"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:scaleType="fitCenter" />
                        <ImageView
                            android:id="@+id/code_b_0"
                            android:layout_width="wrap_content"
                            android:layout_height="22dp"
                            android:adjustViewBounds="true"
                            android:layout_marginStart="6dp"
                            android:scaleType="fitStart" />
                    </LinearLayout>
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />
                    <!-- the labels sit in one fixed slot, drawn to its right edge: "Market" and the Visa badge end
                         where the line between the rows ends, and the numbers keep one right edge -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="6dp">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="16dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <ImageView
                                android:id="@+id/mkt_val_0"
                                android:layout_width="56dp"
                                android:layout_height="15.6dp"
                                android:scaleType="fitEnd" />
                            <ImageView
                                android:id="@+id/mkt_lbl_0"
                                android:layout_width="38dp"
                                android:layout_height="14.3dp"
                                android:layout_marginStart="6dp"
                                android:scaleType="fitEnd" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="16dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="2dp">
                            <ImageView
                                android:id="@+id/visa_val_0"
                                android:layout_width="56dp"
                                android:layout_height="15.6dp"
                                android:scaleType="fitEnd" />
                            <ImageView
                                android:id="@+id/visa_logo_0"
                                android:layout_width="38dp"
                                android:layout_height="16dp"
                                android:layout_marginStart="6dp"
                                android:scaleType="fitEnd" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
            <ImageView
                android:id="@+id/div_1"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="24dp"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/cur_div" />
            <FrameLayout
                android:id="@+id/row_1"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:foreground="?android:attr/selectableItemBackground">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="24dp">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:id="@+id/fl_a_1"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:scaleType="fitCenter" />
                        <!-- a fixed width, so every row's arrow and second flag line up -->
                        <ImageView
                            android:id="@+id/code_a_1"
                            android:layout_width="40dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="6dp"
                            android:scaleType="fitStart" />
                        <ImageView
                            android:id="@+id/arrow_1"
                            android:layout_width="12dp"
                            android:layout_height="16dp"
                            android:src="@drawable/cur_arrow"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="10dp"
                            android:scaleType="fitCenter" />
                        <ImageView
                            android:id="@+id/fl_b_1"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:scaleType="fitCenter" />
                        <ImageView
                            android:id="@+id/code_b_1"
                            android:layout_width="wrap_content"
                            android:layout_height="22dp"
                            android:adjustViewBounds="true"
                            android:layout_marginStart="6dp"
                            android:scaleType="fitStart" />
                    </LinearLayout>
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />
                    <!-- the labels sit in one fixed slot, drawn to its right edge: "Market" and the Visa badge end
                         where the line between the rows ends, and the numbers keep one right edge -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="6dp">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="16dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <ImageView
                                android:id="@+id/mkt_val_1"
                                android:layout_width="56dp"
                                android:layout_height="15.6dp"
                                android:scaleType="fitEnd" />
                            <ImageView
                                android:id="@+id/mkt_lbl_1"
                                android:layout_width="38dp"
                                android:layout_height="14.3dp"
                                android:layout_marginStart="6dp"
                                android:scaleType="fitEnd" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="16dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="2dp">
                            <ImageView
                                android:id="@+id/visa_val_1"
                                android:layout_width="56dp"
                                android:layout_height="15.6dp"
                                android:scaleType="fitEnd" />
                            <ImageView
                                android:id="@+id/visa_logo_1"
                                android:layout_width="38dp"
                                android:layout_height="16dp"
                                android:layout_marginStart="6dp"
                                android:scaleType="fitEnd" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
