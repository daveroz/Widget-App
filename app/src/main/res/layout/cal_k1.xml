<?xml version="1.0" encoding="utf-8"?>
<!-- Generated: calendar widget variant that has room for 1 event row(s). The launcher picks the variant
     that fits the real widget size (see CalendarWidgetProvider). Everything is native views, so width and
     height always adapt exactly. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp">

    <ImageView
        android:id="@+id/cal_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />
    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/cal_panel"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="13dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <!-- header: the number, the month and the "+" all top-aligned on the month's capitals (6.6 dp down) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="51dp"
            android:gravity="top"
            android:orientation="horizontal">
        <!-- the day's number, from the top of the month's capitals to the bottom of the line under it -->
        <ImageView
            android:id="@+id/cal_day"
            android:layout_width="wrap_content"
            android:layout_height="33.4dp"
            android:layout_gravity="top"
            android:layout_marginTop="6.6dp"
            android:adjustViewBounds="true"
            android:scaleType="fitStart" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="2.5dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/cal_month"
                    android:layout_width="match_parent"
                    android:layout_height="23dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitStart" />
                <ImageView
                    android:id="@+id/cal_sub"
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:adjustViewBounds="true"
                    android:layout_marginTop="2dp"
                    android:scaleType="fitStart" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btn_add"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="6.6dp"
                android:contentDescription="New event"
                android:src="@drawable/ic_cal_add" />
        </LinearLayout>

        <!-- week row, a little below the header so today's highlight keeps clear of the "+" -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="9.1dp"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <!-- the day; today it sits on a solid tile in the song's colour (CalendarWidgetProvider) -->
                <LinearLayout
                    android:id="@+id/wk_col_0"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="4dp">
                    <ImageView
                        android:id="@+id/wk_label_0"
                        android:layout_width="wrap_content"
                        android:layout_height="16dp"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter" />
                    <ImageView
                        android:id="@+id/wk_num_0"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:adjustViewBounds="true"
                        android:layout_marginTop="0dp"
                        android:scaleType="fitCenter" />
                </LinearLayout>
            </LinearLayout>
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />
            <LinearLayout
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <!-- the day; today it sits on a solid tile in the song's colour (CalendarWidgetProvider) -->
                <LinearLayout
                    android:id="@+id/wk_col_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="4dp">
                    <ImageView
                        android:id="@+id/wk_label_1"
                        android:layout_width="wrap_content"
                        android:layout_height="16dp"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter" />
                    <ImageView
                        android:id="@+id/wk_num_1"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:adjustViewBounds="true"
                        android:layout_marginTop="0dp"
                        android:scaleType="fitCenter" />
                </LinearLayout>
            </LinearLayout>
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />
            <LinearLayout
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <!-- the day; today it sits on a solid tile in the song's colour (CalendarWidgetProvider) -->
                <LinearLayout
                    android:id="@+id/wk_col_2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="4dp">
                    <ImageView
                        android:id="@+id/wk_label_2"
                        android:layout_width="wrap_content"
                        android:layout_height="16dp"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter" />
                    <ImageView
                        android:id="@+id/wk_num_2"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:adjustViewBounds="true"
                        android:layout_marginTop="0dp"
                        android:scaleType="fitCenter" />
                </LinearLayout>
            </LinearLayout>
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />
            <LinearLayout
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <!-- the day; today it sits on a solid tile in the song's colour (CalendarWidgetProvider) -->
                <LinearLayout
                    android:id="@+id/wk_col_3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="4dp">
                    <ImageView
                        android:id="@+id/wk_label_3"
                        android:layout_width="wrap_content"
                        android:layout_height="16dp"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter" />
                    <ImageView
                        android:id="@+id/wk_num_3"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:adjustViewBounds="true"
                        android:layout_marginTop="0dp"
                        android:scaleType="fitCenter" />
                </LinearLayout>
            </LinearLayout>
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />
            <LinearLayout
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <!-- the day; today it sits on a solid tile in the song's colour (CalendarWidgetProvider) -->
                <LinearLayout
                    android:id="@+id/wk_col_4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="4dp">
                    <ImageView
                        android:id="@+id/wk_label_4"
                        android:layout_width="wrap_content"
                        android:layout_height="16dp"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter" />
                    <ImageView
                        android:id="@+id/wk_num_4"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:adjustViewBounds="true"
                        android:layout_marginTop="0dp"
                        android:scaleType="fitCenter" />
                </LinearLayout>
            </LinearLayout>
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />
            <LinearLayout
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <!-- the day; today it sits on a solid tile in the song's colour (CalendarWidgetProvider) -->
                <LinearLayout
                    android:id="@+id/wk_col_5"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="4dp">
                    <ImageView
                        android:id="@+id/wk_label_5"
                        android:layout_width="wrap_content"
                        android:layout_height="16dp"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter" />
                    <ImageView
                        android:id="@+id/wk_num_5"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:adjustViewBounds="true"
                        android:layout_marginTop="0dp"
                        android:scaleType="fitCenter" />
                </LinearLayout>
            </LinearLayout>
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />
            <LinearLayout
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <!-- the day; today it sits on a solid tile in the song's colour (CalendarWidgetProvider) -->
                <LinearLayout
                    android:id="@+id/wk_col_6"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="4dp">
                    <ImageView
                        android:id="@+id/wk_label_6"
                        android:layout_width="wrap_content"
                        android:layout_height="16dp"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter" />
                    <ImageView
                        android:id="@+id/wk_num_6"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:adjustViewBounds="true"
                        android:layout_marginTop="0dp"
                        android:scaleType="fitCenter" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>


        <!-- the events, on one card, thin lines between them; the day beside each day's first (CalendarWidgetProvider) -->
        <LinearLayout
            android:id="@+id/cal_events"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp"
            android:background="@drawable/cal_card"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:paddingEnd="12dp">
            <LinearLayout
                android:id="@+id/cal_row_0"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <!-- the day: its weekday over its number, beside its first event only -->
                <LinearLayout
                    android:id="@+id/cal_day_0"
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">
                    <ImageView
                        android:id="@+id/cal_dname_0"
                        android:layout_width="wrap_content"
                        android:layout_height="12dp"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter" />
                    <ImageView
                        android:id="@+id/cal_dnum_0"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter" />
                </LinearLayout>
                <ImageView
                    android:id="@+id/cal_bar_0"
                    android:layout_width="3dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="10dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/cal_bar" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <ImageView
                        android:id="@+id/cal_title_0"
                        android:layout_width="match_parent"
                        android:layout_height="19dp"
                        android:adjustViewBounds="true"
                        android:scaleType="fitStart" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <ImageView
                            android:id="@+id/cal_time_0"
                            android:layout_width="wrap_content"
                            android:layout_height="14dp"
                            android:adjustViewBounds="true"
                            android:scaleType="fitStart" />
                        <ImageView
                            android:id="@+id/cal_hint_0"
                            android:layout_width="wrap_content"
                            android:layout_height="14dp"
                            android:adjustViewBounds="true"
                            android:layout_marginStart="8dp"
                            android:scaleType="fitStart" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>