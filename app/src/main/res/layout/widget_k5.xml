<?xml version="1.0" encoding="utf-8"?>
<!-- Generated: the Rates widget with 5 currency row(s) (since 2.26 without the clocks, which have a widget of their
     own): one card holding the rows, thin lines between them; fixed-size content (dp) in flexible rows, so any widget
     size keeps the same proportions. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp">

