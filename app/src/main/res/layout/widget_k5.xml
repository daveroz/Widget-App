                            android:layout_width="26dp"
                            android:layout_height="16dp"
                            android:paddingTop="1.5dp"
                            android:paddingBottom="1.5dp"
                            android:layout_marginTop="2dp"
                            android:scaleType="fitCenter" />
                    </LinearLayout>
