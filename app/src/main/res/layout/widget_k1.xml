<?xml version="1.0" encoding="utf-8"?>
<!-- Generated: the Rates widget with 1 currency row(s) (since 2.26 without the clocks, which have a widget of their
     own): one card holding the rows, thin lines between them; fixed-size content (dp) in flexible rows, so any widget
     size keeps the same proportions. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/rates_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/cur_clocks"
            android:clipToOutline="true"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">
            <FrameLayout
                android:id="@+id/row_0"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:foreground="?android:attr/selectableItemBackground">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:id="@+id/fl_a_0"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:scaleType="fitCenter" />
                        <!-- a fixed width, so every row's arrow and second flag line up -->
                        <ImageView
                            android:id="@+id/code_a_0"
                            android:layout_width="36dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="12dp"
                            android:scaleType="fitStart" />
                        <!-- the arrow with its faint haze round it (2.21): its picture 4 dp bigger all round, the margins
                             4 dp less, so the arrow itself stays 8 x 11 dp where it was -->
                        <ImageView
                            android:id="@+id/arrow_0"
                            android:layout_width="16dp"
                            android:layout_height="19dp"
                            android:src="@drawable/cur_arrow"
                            android:layout_marginStart="6dp"
                            android:layout_marginEnd="12dp"
                            android:scaleType="fitCenter" />
                        <ImageView
                            android:id="@+id/fl_b_0"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:scaleType="fitCenter" />
                        <ImageView
                            android:id="@+id/code_b_0"
                            android:layout_width="wrap_content"
                            android:layout_height="22dp"
                            android:adjustViewBounds="true"
                            android:layout_marginStart="12dp"
                            android:scaleType="fitStart" />
                    </LinearLayout>
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="6dp">
                        <ImageView
                            android:id="@+id/mkt_val_0"
                            android:layout_width="56dp"
                            android:layout_height="15.6dp"
                            android:layout_marginTop="0.2dp"
                            android:layout_marginBottom="0.2dp"
                            android:scaleType="fitEnd" />
                        <ImageView
                            android:id="@+id/visa_val_0"
                            android:layout_width="56dp"
                            android:layout_height="15.6dp"
                            android:layout_marginTop="2.2dp"
                            android:layout_marginBottom="0.2dp"
                            android:scaleType="fitEnd" />
                    </LinearLayout>
                    <!-- the short upright line between the rates and their labels -->
                    <ImageView
                        android:layout_width="1dp"
                        android:layout_height="27dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="12dp"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/cur_div" />
                    <!-- "Market" at the size of the widget's other labels (2.09), the Visa badge centred under it -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <ImageView
                            android:id="@+id/mkt_lbl_0"
                            android:layout_width="wrap_content"
                            android:layout_height="16dp"
                            android:paddingTop="0.85dp"
                            android:paddingBottom="0.85dp"
                            android:adjustViewBounds="true"
                            android:scaleType="fitCenter" />
                        <ImageView
                            android:id="@+id/visa_logo_0"
                            android:layout_width="26dp"
                            android:layout_height="16dp"
                            android:paddingTop="1.5dp"
                            android:paddingBottom="1.5dp"
                            android:layout_marginTop="2dp"
                            android:scaleType="fitCenter" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
