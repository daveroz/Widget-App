                    android:paddingStart="2dp"
                    android:paddingEnd="2dp">
                    <ImageView
                        android:id="@+id/clk_day_7"
                        android:layout_width="match_parent"
                        android:layout_height="17.5dp"
                        android:scaleType="fitCenter" />
                    <ImageView
                        android:id="@+id/clk_time_7"
