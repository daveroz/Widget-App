<?xml version="1.0" encoding="utf-8"?>
<!-- Music widget: its picture (the panel, lit by the light of what's playing) fills it; the controls sit over its
     middle as real views, so taps land exactly: previous, play / pause, next, and the progress line, split into 24
     zones a tap jumps the song to. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/player_name"
        android:scaleType="fitXY" />

    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="18dp"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/btn_prev"
            android:background="@drawable/sound_press"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:contentDescription="@string/sound_prev"
            android:scaleType="fitCenter" />

        <ImageView
            android:id="@+id/btn_play"
            android:background="@drawable/sound_press"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:contentDescription="@string/sound_play_pause"
            android:scaleType="fitCenter" />

        <ImageView
            android:id="@+id/btn_next"
            android:background="@drawable/sound_press"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:contentDescription="@string/sound_next"
            android:scaleType="fitCenter" />

        <ImageView
            android:id="@+id/t_elapsed"
            android:layout_width="wrap_content"
            android:layout_height="11dp"
            android:layout_marginStart="8dp"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:scaleType="fitStart" />

        <FrameLayout
            android:id="@+id/seek"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/bar"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_gravity="center_vertical"
                android:contentDescription="@string/sound_seek"
                android:scaleType="fitXY" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:baselineAligned="false"
                android:orientation="horizontal">
                <FrameLayout
                    android:id="@+id/seek_0"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/sound_press_line" />
                <FrameLayout
                    android:id="@+id/seek_1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/sound_press_line" />
                <FrameLayout
                    android:id="@+id/seek_2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/sound_press_line" />
                <FrameLayout
                    android:id="@+id/seek_3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/sound_press_line" />
                <FrameLayout
                    android:id="@+id/seek_4"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/sound_press_line" />
                <FrameLayout
                    android:id="@+id/seek_5"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/sound_press_line" />
                <FrameLayout
                    android:id="@+id/seek_6"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/sound_press_line" />
                <FrameLayout
                    android:id="@+id/seek_7"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/sound_press_line" />
                <FrameLayout
                    android:id="@+id/seek_8"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/sound_press_line" />
                <FrameLayout
                    android:id="@+id/seek_9"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/sound_press_line" />
                <FrameLayout
                    android:id="@+id/seek_10"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/sound_press_line" />
                <FrameLayout
                    android:id="@+id/seek_11"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/sound_press_line" />
                <FrameLayout
                    android:id="@+id/seek_12"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/sound_press_line" />
                <FrameLayout
                    android:id="@+id/seek_13"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/sound_press_line" />
                <FrameLayout
                    android:id="@+id/seek_14"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/sound_press_line" />
                <FrameLayout
                    android:id="@+id/seek_15"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/sound_press_line" />
                <FrameLayout
                    android:id="@+id/seek_16"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/sound_press_line" />
                <FrameLayout
                    android:id="@+id/seek_17"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/sound_press_line" />
                <FrameLayout
                    android:id="@+id/seek_18"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/sound_press_line" />
                <FrameLayout
                    android:id="@+id/seek_19"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/sound_press_line" />
                <FrameLayout
                    android:id="@+id/seek_20"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/sound_press_line" />
                <FrameLayout
                    android:id="@+id/seek_21"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/sound_press_line" />
                <FrameLayout
                    android:id="@+id/seek_22"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/sound_press_line" />
                <FrameLayout
                    android:id="@+id/seek_23"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/sound_press_line" />
            </LinearLayout>
        </FrameLayout>

        <ImageView
            android:id="@+id/t_total"
            android:layout_width="wrap_content"
            android:layout_height="11dp"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:scaleType="fitEnd" />
    </LinearLayout>
</FrameLayout>
