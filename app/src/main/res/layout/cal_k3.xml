<?xml version="1.0" encoding="utf-8"?>
<!-- Generated: calendar widget variant that has room for 3 event row(s). The launcher picks the variant
     that fits the real widget size (see CalendarWidgetProvider). Everything is native views, so width and
     height always adapt exactly. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp">

    <ImageView
        android:id="@+id/cal_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />
    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/cal_panel"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="13dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp">

        <!-- header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
        <ImageView
            android:id="@+id/cal_day"
            android:layout_width="wrap_content"
            android:layout_height="47dp"
            android:adjustViewBounds="true"
            android:scaleType="fitStart" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/cal_month"
                    android:layout_width="match_parent"
                    android:layout_height="23dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitStart" />
                <ImageView
                    android:id="@+id/cal_sub"
                    android:layout_width="match_parent"
                    android:layout_height="16dp"
                    android:adjustViewBounds="true"
                    android:layout_marginTop="2dp"
                    android:scaleType="fitStart" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btn_add"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="New event"
                android:src="@drawable/ic_cal_add" />
        </LinearLayout>

        <!-- week row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/wk_label_0"
                    android:layout_width="wrap_content"
                    android:layout_height="14dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter" />
                <ImageView
                    android:id="@+id/wk_num_0"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:adjustViewBounds="true"
                    android:layout_marginTop="3dp"
                    android:scaleType="fitCenter" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/wk_label_1"
                    android:layout_width="wrap_content"
                    android:layout_height="14dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter" />
                <ImageView
                    android:id="@+id/wk_num_1"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:adjustViewBounds="true"
                    android:layout_marginTop="3dp"
                    android:scaleType="fitCenter" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/wk_label_2"
                    android:layout_width="wrap_content"
                    android:layout_height="14dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter" />
                <ImageView
                    android:id="@+id/wk_num_2"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:adjustViewBounds="true"
                    android:layout_marginTop="3dp"
                    android:scaleType="fitCenter" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/wk_label_3"
                    android:layout_width="wrap_content"
                    android:layout_height="14dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter" />
                <ImageView
                    android:id="@+id/wk_num_3"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:adjustViewBounds="true"
                    android:layout_marginTop="3dp"
                    android:scaleType="fitCenter" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/wk_label_4"
                    android:layout_width="wrap_content"
                    android:layout_height="14dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter" />
                <ImageView
                    android:id="@+id/wk_num_4"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:adjustViewBounds="true"
                    android:layout_marginTop="3dp"
                    android:scaleType="fitCenter" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/wk_label_5"
                    android:layout_width="wrap_content"
                    android:layout_height="14dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter" />
                <ImageView
                    android:id="@+id/wk_num_5"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:adjustViewBounds="true"
                    android:layout_marginTop="3dp"
                    android:scaleType="fitCenter" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/wk_label_6"
                    android:layout_width="wrap_content"
                    android:layout_height="14dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter" />
                <ImageView
                    android:id="@+id/wk_num_6"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:adjustViewBounds="true"
                    android:layout_marginTop="3dp"
                    android:scaleType="fitCenter" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:scaleType="fitXY"
            android:src="@drawable/cal_divider" />

        <!-- events -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">
        <LinearLayout
            android:id="@+id/cal_row_0"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/cal_bar_0"
                android:layout_width="4dp"
                android:layout_height="30dp"
                android:layout_marginEnd="11dp"
                android:scaleType="fitXY"
                android:src="@drawable/cal_bar" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <ImageView
                        android:id="@+id/cal_time_0"
                        android:layout_width="wrap_content"
                        android:layout_height="16dp"
                        android:adjustViewBounds="true"
                        android:scaleType="fitStart" />
                    <ImageView
                        android:id="@+id/cal_hint_0"
                        android:layout_width="wrap_content"
                        android:layout_height="16dp"
                        android:adjustViewBounds="true"
                        android:layout_marginStart="9dp"
                        android:scaleType="fitStart" />
                </LinearLayout>
                <ImageView
                    android:id="@+id/cal_title_0"
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:adjustViewBounds="true"
                    android:layout_marginTop="1dp"
                    android:scaleType="fitStart" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/cal_row_1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/cal_bar_1"
                android:layout_width="4dp"
                android:layout_height="30dp"
                android:layout_marginEnd="11dp"
                android:scaleType="fitXY"
                android:src="@drawable/cal_bar" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <ImageView
                        android:id="@+id/cal_time_1"
                        android:layout_width="wrap_content"
                        android:layout_height="16dp"
                        android:adjustViewBounds="true"
                        android:scaleType="fitStart" />
                    <ImageView
                        android:id="@+id/cal_hint_1"
                        android:layout_width="wrap_content"
                        android:layout_height="16dp"
                        android:adjustViewBounds="true"
                        android:layout_marginStart="9dp"
                        android:scaleType="fitStart" />
                </LinearLayout>
                <ImageView
                    android:id="@+id/cal_title_1"
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:adjustViewBounds="true"
                    android:layout_marginTop="1dp"
                    android:scaleType="fitStart" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/cal_row_2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/cal_bar_2"
                android:layout_width="4dp"
                android:layout_height="30dp"
                android:layout_marginEnd="11dp"
                android:scaleType="fitXY"
                android:src="@drawable/cal_bar" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <ImageView
                        android:id="@+id/cal_time_2"
                        android:layout_width="wrap_content"
                        android:layout_height="16dp"
                        android:adjustViewBounds="true"
                        android:scaleType="fitStart" />
                    <ImageView
                        android:id="@+id/cal_hint_2"
                        android:layout_width="wrap_content"
                        android:layout_height="16dp"
                        android:adjustViewBounds="true"
                        android:layout_marginStart="9dp"
                        android:scaleType="fitStart" />
                </LinearLayout>
                <ImageView
                    android:id="@+id/cal_title_2"
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:adjustViewBounds="true"
                    android:layout_marginTop="1dp"
                    android:scaleType="fitStart" />
            </LinearLayout>
        </LinearLayout>
        </LinearLayout>
        <ImageView
            android:id="@+id/cal_more"
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:adjustViewBounds="true"
            android:scaleType="fitEnd" />
    </LinearLayout>
</FrameLayout>