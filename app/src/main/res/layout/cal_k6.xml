                                android:layout_height="14dp"
                                android:adjustViewBounds="true"
                                android:scaleType="fitStart" />
                            <ImageView
                                android:id="@+id/cal_hint_4"
                                android:layout_width="wrap_content"
                                android:layout_height="14dp"
                                android:adjustViewBounds="true"
                                android:layout_marginStart="8dp"
                                android:scaleType="fitStart" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/cal_row_5"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <!-- one line, 40 dp tall: the day beside the event's tile (or, for a day with nothing on, both on one tile) -->
            <LinearLayout
                android:id="@+id/cal_line_5"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <!-- the day: its weekday over its number, beside its first event only -->
                <LinearLayout
                    android:id="@+id/cal_day_5"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">
                    <ImageView
                        android:id="@+id/cal_dname_5"
                        android:layout_width="wrap_content"
                        android:layout_height="12dp"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter" />
                    <ImageView
                        android:id="@+id/cal_dnum_5"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter" />
                </LinearLayout>
                <!-- the event, on its tile -->
                <LinearLayout
                    android:id="@+id/cal_tile_5"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/cal_event"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp">
                    <ImageView
                        android:id="@+id/cal_bar_5"
                        android:layout_width="3dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="9dp"
                        android:scaleType="fitXY"
                        android:src="@drawable/cal_bar" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <ImageView
                            android:id="@+id/cal_title_5"
                            android:layout_width="match_parent"
                            android:layout_height="19dp"
                            android:adjustViewBounds="true"
                            android:scaleType="fitStart" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <ImageView
                                android:id="@+id/cal_time_5"
                                android:layout_width="wrap_content"
                                android:layout_height="14dp"
                                android:adjustViewBounds="true"
                                android:scaleType="fitStart" />
                            <ImageView
                                android:id="@+id/cal_hint_5"
                                android:layout_width="wrap_content"
                                android:layout_height="14dp"
                                android:adjustViewBounds="true"
                                android:layout_marginStart="8dp"
                                android:scaleType="fitStart" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        </LinearLayout>
        <ImageView
            android:id="@+id/cal_more"
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:adjustViewBounds="true"
            android:scaleType="fitEnd" />
    </LinearLayout>
</FrameLayout>