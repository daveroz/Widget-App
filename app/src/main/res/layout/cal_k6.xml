<?xml version="1.0" encoding="utf-8"?>
<!-- Generated: calendar widget variant that has room for 6 event row(s). The launcher picks the variant
     that fits the real widget size (see CalendarWidgetProvider). Everything is native views, so width and
     height always adapt exactly. -->
