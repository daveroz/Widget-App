<?xml version="1.0" encoding="utf-8"?>
<!-- An event's tile in the Calendar widget: dark, with the glass rim every button has (light caught by its edge,
     brightest at the top left, faint across the middle, softer again at the bottom right), and the same 12 dp corners
     as every other control. The rim is a 1 dp ring of a 45° gradient showing round the fill. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:angle="315"
                android:centerColor="#08F3ECE8"
                android:endColor="#26F3ECE8"
                android:startColor="#45F3ECE8" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="11dp" />
            <solid android:color="#FF1E1F23" />
        </shape>
    </item>
</layer-list>
