<?xml version="1.0" encoding="utf-8"?>
<!-- Today in the Calendar's week row (since 2.26): no colour of its own and no glow, a raised pill of grey glass as the
     app's segmented control has, lighter at its top, a faint icy line round it; its day name and number in white. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#FF22262E"
        android:startColor="#FF30353F" />
    <stroke
        android:width="1dp"
        android:color="#24E2EEFF" />
    <corners android:radius="12dp" />
</shape>
