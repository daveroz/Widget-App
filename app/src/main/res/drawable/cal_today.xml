<?xml version="1.0" encoding="utf-8"?>
<!-- Today in the Calendar's week row: a solid tile behind its day name and number, in the song's colour (tinted on
     Android 12 and up; before that it stays Worldly's amber), with the same corners as every other control. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#FFEB9438" />
    <corners android:radius="12dp" />
</shape>
