<?xml version="1.0" encoding="utf-8"?>
<!-- The Calendar's events card: dark, with the glass rim every button has (light caught by its edge, brightest at the
     top left, faint across the middle, softer again at the bottom right); a 1 dp ring of a 45° gradient round the
     fill. Its rows are divided by thin lines (cur_div). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="315"
                android:centerColor="#08F3ECE8"
                android:endColor="#26F3ECE8"
                android:startColor="#45F3ECE8" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="17dp" />
            <solid android:color="#FF1A1B1F" />
        </shape>
    </item>
</layer-list>
