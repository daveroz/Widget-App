<?xml version="1.0" encoding="utf-8"?>
<!-- Night glass with a hairline edge and a faint wash of the key light from the top right. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#F00C1322" android:endColor="#F0070A10" />
            <stroke android:width="1dp" android:color="#2EAADCFF" />
            <corners android:radius="@dimen/widget_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:centerX="0.9" android:centerY="0.0" android:gradientRadius="200dp"
                android:startColor="#2EEB9438" android:centerColor="#0DEB9438" android:endColor="#00EB9438" />
            <corners android:radius="@dimen/widget_radius" />
        </shape>
    </item>
</layer-list>
